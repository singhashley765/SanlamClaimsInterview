{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "App": {
    "LogFolder": "logs"
  },
  "ConnectionStrings": {
    "ClaimsDb": "Server=localhost,1433;Database=SanlamClaims;User Id=sa;Password=Your_password123;TrustServerCertificate=True"
  },
  "ExternalSystems": {
    "ClientRegistryBaseUrl": "https://client-registry.internal.sanlam.co.za",
    "PolicyManagementBaseUrl": "https://policy-management.internal.sanlam.co.za",
    "PaymentBaseUrl": "https://payments.internal.sanlam.co.za"
  },
  "ServiceBus": {
    "ConnectionString": "Endpoint=sb://sanlam-claims.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=placeholder",
    "QueueName": "payment-requests"
  },
  "Auth": {
    "Username": "analyst",
    "Password": "Your_password123",
    "JwtSigningKey": "placeholder-signing-key-replace-before-any-real-use-0123456789",
    "JwtIssuer": "SanlamClaims",
    "JwtAudience": "SanlamClaims",
    "JwtExpiryMinutes": 60
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  }
}
